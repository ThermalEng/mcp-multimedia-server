# .env.example — 复制为 `~/.config/mcp-multimedia/.env` 并填入真实值
# 服务端启动时会自动加载该文件(process env 优先)。

# --- 上游(OpenAI 兼容端点) ---
MCP_MEDIA_BASE_URL=https://your-provider.example/v1
MCP_MEDIA_API_KEY=sk-your-key-here
MCP_MEDIA_MODEL=mimo-v2.5

# --- 输出 / 推理 ---
MCP_MEDIA_MAX_TOKENS=65536
# 设为 none 关闭模型推理(reasoning_tokens=0,省输出长度);留空=用模型默认
MCP_MEDIA_REASONING_EFFORT=none

# --- 文件大小上限(字节,本地/内联输入) ---
MCP_MEDIA_MAX_IMAGE_SIZE=41943040   # 40MB
MCP_MEDIA_MAX_VIDEO_SIZE=41943040   # 40MB
MCP_MEDIA_MAX_AUDIO_SIZE=20971520   # 20MB
